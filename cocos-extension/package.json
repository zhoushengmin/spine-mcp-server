{
  "package_version": 2,
  "name": "spine-mcp-panel",
  "version": "1.0.0",
  "description": "Spine MCP Server 的 Cocos Creator 可视化面板：一键启动 MCP 服务、扫描 Spine 项目、调用 Spine 工具、生成 AI 客户端配置。",
  "author": "spine-mcp",
  "main": "./main.js",
  "dependencies": {},
  "panels": {
    "default": {
      "title": "Spine MCP Server",
      "type": "dockable",
      "main": "./panel/panel.js",
      "size": {
        "width": 640,
        "height": 520
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.extension/Spine MCP Server",
        "label": "Spine MCP Server",
        "message": "open-panel"
      }
    ],
    "messages": {
      "open-panel": {
        "methods": [ "open-panel" ],
        "doc": "打开 Spine MCP Server 面板"
      },
      "spine:start": {
        "methods": [ "spine:start" ],
        "doc": "启动 MCP 服务"
      },
      "spine:stop": {
        "methods": [ "spine:stop" ],
        "doc": "停止 MCP 服务"
      },
      "spine:status": {
        "methods": [ "spine:status" ],
        "doc": "查询服务状态"
      },
      "spine:list-projects": {
        "methods": [ "spine:list-projects" ],
        "doc": "扫描工作区 .spine 项目"
      },
      "spine:get-info": {
        "methods": [ "spine:get-info" ],
        "doc": "获取 Spine 项目信息"
      },
      "spine:run-tool": {
        "methods": [ "spine:run-tool" ],
        "doc": "调用 Spine 工具"
      },
      "spine:get-config": {
        "methods": [ "spine:get-config" ],
        "doc": "读取配置"
      },
      "spine:set-config": {
        "methods": [ "spine:set-config" ],
        "doc": "写入配置"
      },
      "spine:get-cli-config": {
        "methods": [ "spine:get-cli-config" ],
        "doc": "生成 AI 客户端 MCP 配置片段"
      },
      "spine:list-tools": {
        "methods": [ "spine:list-tools" ],
        "doc": "列出全部 Spine 工具"
      }
    }
  }
}
