{
  "name": "spine-mcp-panel",
  "version": "1.0.0",
  "description": "Spine MCP Server 的 Cocos Creator 可视化面板：一键启动 MCP 服务、扫描 Spine 项目、调用 Spine 工具、生成 AI 客户端配置。",
  "author": "spine-mcp",
  "main": "./main.js",
  "extensionType": "app",
  "dependencies": {},
  "contributions": {
    "panel": {
      "main": "./panel/panel.js",
      "type": "dockable",
      "title": "Spine MCP Server",
      "icon": {
        "font": "database",
        "content": "\\ue946"
      },
      "doc": "http://esotericsoftware.com"
    },
    "messages": {
      "spine:start": {
        "methods": [ "spine:start" ],
        "doc": "启动 MCP 服务"
      },
      "spine:stop": {
        "methods": [ "spine:stop" ],
        "doc": "停止 MCP 服务"
      },
      "spine:status": {
        "methods": [ "spine:status" ],
        "doc": "查询服务状态"
      },
      "spine:list-projects": {
        "methods": [ "spine:list-projects" ],
        "doc": "扫描工作区 .spine 项目"
      },
      "spine:get-info": {
        "methods": [ "spine:get-info" ],
        "doc": "获取 Spine 项目信息"
      },
      "spine:run-tool": {
        "methods": [ "spine:run-tool" ],
        "doc": "调用 Spine 工具"
      },
      "spine:get-config": {
        "methods": [ "spine:get-config" ],
        "doc": "读取配置"
      },
      "spine:set-config": {
        "methods": [ "spine:set-config" ],
        "doc": "写入配置"
      }
    }
  }
}
