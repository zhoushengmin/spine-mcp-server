{
  "name": "spine-mcp-server",
  "version": "0.1.0",
  "description": "AI-driven Spine 3.8.75 animation workflow server - 55 MCP tools for Trae, Cursor, Claude Desktop, Codex, Windsurf, Cline and any MCP-compatible AI client",
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "spine-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "docs/",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "spine",
    "spine-3.8",
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "animation",
    "skeleton",
    "cocos",
    "cocos-creator",
    "game-development",
    "ai-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhoushengmin/spine-mcp-server.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "node dist/index.js check",
    "info": "node dist/index.js info",
    "installer": "node scripts/installer.js",
    "package:ccx": "node scripts/package-ccx.js",
    "manual:html": "node scripts/gen-manual-html.js",
    "test:unit": "node --test tests/unit-tests.mjs",
    "test:all": "node --test tests/unit-tests.mjs && node tests/self-test-tools.cjs && node tests/self-test-p4.cjs && node tests/self-test-p5.cjs && node tests/self-test-render.cjs && node tests/self-test-mcp.cjs && node tests/self-test-extension.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "canvas": "^3.2.3",
    "dotenv": "^16.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
